# The landing page does not collect email. These settings are not required to build it.
# This opt-in only unlocks the dormant adapter; it does not mount a signup form.
VITE_WAITLIST_SIGNUPS_ENABLED=false
# Public Supabase credentials only. Never use a service role key in a frontend build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
